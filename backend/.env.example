OPENAI_API_KEY=your_openai_api_key_here
# Required. No default in code: OpenAI retires models, so pick a current one.
# Check https://developers.openai.com/api/docs/deprecations before changing it.
OPENAI_MODEL=gpt-6-luna
# Optional. Leave unset for models that reject a custom temperature.
# OPENAI_TEMPERATURE=0
# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:5173
RATE_LIMIT=5/minute
