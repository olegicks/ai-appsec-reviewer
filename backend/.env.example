OPENAI_API_KEY=your_openai_api_key_here
# Required for AI triage. No default in code: OpenAI retires models, so pick a current one.
# Check https://developers.openai.com/api/docs/deprecations before changing it.
# Without a key or model the API still runs and returns deterministic results only.
OPENAI_MODEL=gpt-6-luna
# Optional. Leave unset for models that reject a custom temperature.
# OPENAI_TEMPERATURE=0

# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:5173
# Per-IP limit for /analyze and /report
RATE_LIMIT=5/minute

# Repository scan limits
MAX_REPO_FILES=20
MAX_CONFIG_FILES=10
MAX_FILE_BYTES=30720
MAX_CONTEXT_CHARS=60000

# Dependency check against OSV.dev (set to false to disable all outbound OSV calls)
OSV_ENABLED=true
OSV_TIMEOUT=8
OSV_BUDGET=15
OSV_MAX_PACKAGES=200
OSV_MAX_VULNS=30
